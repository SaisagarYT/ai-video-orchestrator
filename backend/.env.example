# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Upstash Redis (Optional / Transient)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Provider Selection (mock | openrouter | fal | elevenlabs | cloudinary)
AI_LLM_PROVIDER=mock
AI_VIDEO_PROVIDER=mock
AI_AUDIO_PROVIDER=mock
AI_STORAGE_PROVIDER=mock

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
AI_TIMEOUT_MS=60000

# Fal.ai Video Configuration
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/fast-svd
AI_VIDEO_TIMEOUT_MS=120000
AI_VIDEO_POLL_INTERVAL_MS=2000
AI_VIDEO_MAX_POLL_TIME_MS=300000

# ElevenLabs Audio Configuration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
AI_AUDIO_TIMEOUT_MS=60000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_STORAGE_TIMEOUT_MS=60000

# Queue Configuration
QUEUE_CONCURRENCY=2
